@Host_HostAddress = http://localhost:5214

### Create a task
# @name createTask
POST {{Host_HostAddress}}/api/tasks
Content-Type: application/json
Accept: application/json

{
  "title": "Task title",
  "description": "Task description"
}

### Get the task
# @name getTask
GET {{Host_HostAddress}}/api/tasks/{{createTask.response.body.id}}
Content-Type: application/json
Accept: application/json

### Complete the task
PUT {{Host_HostAddress}}/api/tasks/{{createTask.response.body.id}}
Content-Type: application/json
Accept: application/json

{
  "title": "{{getTask.response.body.title}}",
  "description": "{{getTask.response.body.description}}",
  "iscompleted": true,
  "version": "{{getTask.response.body.version}}"
}

### Get completed tasks
GET {{Host_HostAddress}}/api/tasks?isCompleted=true
Content-Type: application/json
Accept: application/json

### Get all tasks
GET {{Host_HostAddress}}/api/tasks
Content-Type: application/json
Accept: application/json

### Delete a task
DELETE {{Host_HostAddress}}/api/tasks/c87d3f4c-ff5e-41a4-a254-2ce22e345d68
Content-Type: application/json
Accept: application/json